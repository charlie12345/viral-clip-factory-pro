# No API keys are required for local clip generation.
# This file is optional and only controls local runtime settings.

PORT=3000
HOST=127.0.0.1
VCF_PYTHON_PATH=./venv/bin/python
VCF_FFMPEG_PATH=ffmpeg
VCF_FFPROBE_PATH=ffprobe
VCF_VAAPI_DEVICE=/dev/dri/renderD128
# For any network-accessible deployment, set this to the public URL for the
# exact corresponding source revision. AGPL-3.0 requires users to be offered it.
# VCF_SOURCE_URL=https://github.com/your-account/viral-clip-factory/tree/main
# VCF_MAX_UPLOAD_BYTES=53687091200
# VCF_REQUEST_TIMEOUT_MS=0
# VCF_UPLOAD_IDLE_TIMEOUT_MS=1800000

# Large multi-video montage uploads. Put this on a roomy persistent disk; do
# not use a RAM-backed /tmp directory. Defaults are 20GB/file, 100GB/job,
# 32MB resumable chunks, a 72-hour resume window, and a 50GB free-space reserve.
# VCF_MEDIA_ROOT=/mnt/large-media/viral-clip-factory
# Set this when MEDIA_ROOT lives on removable storage. Startup will fail safely
# instead of writing through to the system disk if that mount is unavailable.
# VCF_MEDIA_MOUNT=/mnt/large-media
# VCF_COMPILATION_MAX_FILE_BYTES=21474836480
# VCF_COMPILATION_MAX_TOTAL_BYTES=107374182400
# VCF_COMPILATION_CHUNK_BYTES=33554432
# VCF_COMPILATION_SESSION_TTL_MS=259200000
# VCF_COMPILATION_MIN_FREE_BYTES=53687091200

# Optional local analysis providers. These keep media and transcripts on-device.
# scripts/install-whisper-cpp.sh can write these with --env-file or print them.
# Use full absolute paths here; the dashboard does not expand a leading "~".
# VCF_WHISPER_CPP_PATH=/home/your-user/.local/bin/whisper-cli
# VCF_WHISPER_CPP_MODEL=/home/your-user/.local/share/whisper.cpp/models/ggml-large-v3.bin
# VCF_WHISPER_CPP_LANGUAGE=auto
# VCF_WHISPER_CPP_VAD_MODEL=/home/your-user/.local/share/whisper.cpp/models/ggml-silero-v6.2.0.bin
# Optional VAD tuning; invalid values are ignored in favor of whisper.cpp defaults.
# VCF_WHISPER_CPP_VAD_THRESHOLD=0.5
# VCF_WHISPER_CPP_VAD_MIN_SPEECH_DURATION_MS=250
# VCF_WHISPER_CPP_VAD_MIN_SILENCE_DURATION_MS=100
# VCF_WHISPER_CPP_VAD_MAX_SPEECH_DURATION_S=300
# VCF_WHISPER_CPP_VAD_SPEECH_PAD_MS=30
# VCF_WHISPER_CPP_VAD_SAMPLES_OVERLAP=0.1
# VCF_LOCAL_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
# VCF_LOCAL_LLM_MODEL=your-local-model-name
# VCF_LOCAL_LLM_API_KEY=

# Optional cloud providers. These can also be saved from Settings → Provider
# credentials. A key only makes the provider available; each job must still
# opt in from the dashboard before media is uploaded.
# DEEPGRAM_API_KEY=
# GEMINI_API_KEY=
# VCF_GEMINI_MODEL=gemini-3.5-flash
# VCF_GEMINI_TIMEOUT_SEC=900
