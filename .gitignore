# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519

# Dependencies and virtualenvs
node_modules/
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime state (generated on each machine)
dashboard/runtime/*
!dashboard/runtime/.gitkeep

dashboard/uploads/*
!dashboard/uploads/pending/
!dashboard/uploads/pending/.gitkeep
!dashboard/uploads/processing/
!dashboard/uploads/processing/.gitkeep

temp_processing/*
!temp_processing/.gitkeep

viral_clips/*
!viral_clips/.gitkeep
!viral_clips/_sources/
viral_clips/_sources/*
!viral_clips/_sources/.gitkeep

# Media — never commit user footage or exports
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v
*.wmv
*.flv
*.mpeg
*.mpg
*.3gp
*.ts
# This is a TypeScript project. Keep application, test, and setup source files
# visible to Git while still ignoring transport-stream footage elsewhere.
!webui/**/*.ts
!dashboard/**/*.ts
!scripts/**/*.ts
!tests/**/*.ts
*.m4a
*.wav
*.mp3
*.aac
*.flac
*.opus

# Model weights and ML caches (downloaded at runtime)
yolov8*.pt
*.pt
*.pth
*.onnx
*.gguf
*.bin
weights/
runs/
.cache/
models/

# Generated web build (rebuilt by setup scripts)
dashboard/public/dist/

# Local tool downloads — setup expects ffmpeg on PATH; do not vendor binaries.
tools/ffmpeg-current
tools/ffmpeg-*/
tools/*.tar.*

# Editor / OS junk
*.log
*.tmp
*.part
*.swp
*.swo
*.tsbuildinfo
*.yuv444p-backup
.DS_Store
Thumbs.db
desktop.ini

# Local media roots sometimes mounted into the repo tree
media/
data/
uploads/
